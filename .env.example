# LOCAL DEVELOPMENT ONLY: copy to .env.local. Production injects environment
# variables through the host; never ship this file or .env.local with a release.
DATABASE_URL=postgresql://localhost:5432/loopend_dev
APP_URL=http://127.0.0.1:3000
# WEB ONLY. Generate: openssl rand -base64 32 (never a placeholder)
# Do not inject the auth signing secret into the worker.
BETTER_AUTH_SECRET=

# Required for BOTH production web and worker. Optional for local manual Loops.
# Canonical APP_URL + /api/gmail/callback must exactly match Google's redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 32 random bytes, canonical base64. Generate: openssl rand -base64 32
# Keep stable; changing this key requires reconnecting existing accounts.
SOURCE_TOKEN_ENCRYPTION_KEY=
LOOP_SCAN_AI_API_KEY=
# OpenAI-compatible API root, HTTPS in production. No built-in model default.
LOOP_SCAN_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
LOOP_SCAN_AI_MODEL=

# RELEASE PROCESS ONLY: direct privileged connection; never inject into web/worker.
# If absent db:migrate uses DATABASE_URL. Runtime should use a separate limited role.
MIGRATION_DATABASE_URL=

# LOCAL TESTS ONLY: loopback host and a separate database with a 'test' name segment.
TEST_DATABASE_URL=postgresql://localhost:5432/loopend_test
# Optional local production-build testing only (requires loopback APP_URL + database).
# LOOPEND_DEPLOYMENT=local
# Production scripts set NODE_ENV=production. LOOPEND_DEPLOYMENT=production can
# explicitly enforce the production contract under another launcher.
# PORT=3000 (web); LOOPEND_WORKER_ONCE=1 (bounded worker drain, then exit).
