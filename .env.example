DATABASE_URL=postgresql://localhost:5432/loopend_dev
TEST_DATABASE_URL=postgresql://localhost:5432/loopend_test
# Required for production. Optional for local development on loopback only.
APP_PASSWORD=
SESSION_SECRET=

# Loop Scan: all optional until Gmail scanning is enabled. Never use NEXT_PUBLIC_ prefixes.
# Register this exact callback with your Google OAuth Web application:
# http://localhost:3000/api/gmail/callback (use your HTTPS origin in production).
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A separate 32-byte AES key, base64 encoded. Generate with: openssl rand -base64 32
# Keep stable while connections exist; rotating requires reconnecting Gmail.
SOURCE_TOKEN_ENCRYPTION_KEY=

# Default adapter: OpenAI-compatible structured chat completion endpoint.
LOOP_SCAN_AI_API_KEY=
LOOP_SCAN_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
LOOP_SCAN_AI_MODEL=openai/gpt-4.1-mini
